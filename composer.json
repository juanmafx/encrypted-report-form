{
    "name": "juanmafx/fang",
    "description": "Hardened PHP contact form with an encrypted submission store and a TOTP-protected admin area.",
    "type": "project",
    "version": "1.0.0",
    "license": "proprietary",
    "require": {
        "php": ">=8.4 <8.6",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "ext-pdo_sqlite": "*",
        "ext-sodium": "*",
        "psr/clock": "^1.0",
        "spomky-labs/otphp": "^11.4",
        "symfony/mailer": "^7.4"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^12.5"
    },
    "autoload": { "psr-4": { "Fang\\": "backend/src/" } },
    "autoload-dev": { "psr-4": { "Fang\\Tests\\": "backend/tests/" } },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --no-progress"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": false,
        "platform": { "php": "8.4.0" },
        "audit": { "abandoned": "report" }
    }
}
